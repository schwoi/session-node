# Copy to .env (ignored by Git), then replace these values.
L2_PROVIDER=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Optional: auto-detected when empty; use the public IPv4 forwarded to this host.
SERVICE_NODE_IP_ADDRESS=
# Required only when starting stagenet services.
STAGENET_L2_PROVIDER=https://arbitrum-sepolia.infura.io/v3/YOUR_API_KEY
# Required only to authorize clients of the optional L2 proxy.
L2_PROXY_CLIENTS=
# Optional: choose a published version instead of latest.
# SESSION_NODE_IMAGE=ghcr.io/schwoi/session-node:11.6.1.0
