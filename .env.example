# Copy to .env (ignored by Git), then replace these values.
L2_PROVIDER=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Optional: auto-detected when empty; use the public IPv4 forwarded to this host.
SERVICE_NODE_IP_ADDRESS=
# Required only when starting stagenet services.
STAGENET_L2_PROVIDER=https://arbitrum-sepolia.infura.io/v3/YOUR_API_KEY
# Optional additional authorized clients; automatic setup discovers local nodes.
L2_PROXY_CLIENTS=
# Optional: choose a published version instead of latest.
# SESSION_NODE_IMAGE=ghcr.io/schwoi/session-node:11.6.1.0
# Management dashboard (docker compose up -d --no-build manager). Published on
# localhost only unless MANAGER_BIND is changed; set a token before exposing it.
MANAGER_TOKEN=
# MANAGER_BIND=127.0.0.1
# MANAGER_PORT=8080
# Multi-server dashboard over a mesh such as Netbird: bind each manager to its
# mesh address, use the same MANAGER_TOKEN everywhere, and list peers on the hub.
# MANAGER_HOST=nodes-a
# MANAGER_PEERS=nodes-b=http://100.64.0.3:8080,proxy-1=http://100.64.0.7:8080
# Seconds between samples of one node (spread evenly, one at a time) and between
# fetches of a peer's cached listing. Dashboards always read the cache.
# MANAGER_POLL_INTERVAL=300
# MANAGER_PEER_INTERVAL=60
# SESSION_MANAGER_IMAGE=ghcr.io/schwoi/session-node-manager:latest
# Rootless Docker hosts: DOCKER_SOCKET=/run/user/1000/docker.sock
